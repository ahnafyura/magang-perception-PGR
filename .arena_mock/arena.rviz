Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Arena
      Topic:
        Value: /arena/markers
        Depth: 5
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
  Global Options:
    Background Color: 20; 30; 40
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Atas
      Scale: 32
      X: 12
      Y: 6.5
      Angle: 0
      Near Clip Distance: 0.01
      Far Clip Distance: 1000
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 800
  Width: 1400
