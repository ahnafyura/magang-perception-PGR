Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 5
      Plane Cell Count: 120
      Color: 160; 160; 164
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR mentah
      Enabled: true
      Topic:
        Value: /wamv/sensors/lidars/lidar_wamv_sensor/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.08
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.9
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle (filter)
      Enabled: true
      Topic:
        Value: /perception/lidar/obstacles
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 8
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Cluster LiDAR
      Enabled: true
      Topic:
        Value: /perception/lidar/clusters
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Buoy (fusion)
      Enabled: true
      Topic:
        Value: /perception/buoys/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Kamera
      Enabled: true
      Topic:
        Value: /wamv/sensors/cameras/front_left_camera_sensor/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Deteksi
      Enabled: true
      Topic:
        Value: /perception/yolo/debug
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: wamv/wamv/base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 14
      X: 25
      Y: 0
      Angle: 0
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  Kamera:
    collapsed: false
  Deteksi:
    collapsed: false
